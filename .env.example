# Copy to .env for local runs (docker compose) or paste into Railway > Variables.
# There are no passwords: the site opens on a "choose an account" screen.

# Seconds of SHIP time that Earth lags behind. 1200 = 20 minutes; the generator runs ship time faster.
SIGNAL_DELAY_SEC=1200

# Demo mode keeps the tamper-test endpoint enabled.
DEMO_MODE=true

# Where per-visitor demo databases live. On Railway mount a volume here (e.g. /data).
DATA_DIR=./data

# At most this many visitor sandboxes are kept in memory; the least recently used is dropped first.
MAX_WORKSPACES=40
# A sandbox idle for this many seconds is deleted (10800 = 3 hours).
WORKSPACE_TTL_SEC=10800

# Browser origins allowed to call the API (comma separated), e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Only for the shared default workspace (devices that are not the browser generator).
DEVICE_TOKENS=
